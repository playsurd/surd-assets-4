␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"TRY NOT TO GET CRUSHED BY THOSE MOVING MECHANICAL PLATFORMS."}
]␀␀␀␀[
	{"Text":"EVERYTHING IS SO BROWN AND ABANDONED HERE."},
	{"Text":"IT IS KIND OF DEPRESSING EVEN..."},
	{"Text":"BUT IT ALSO MAKES ME HUNGRY FOR CHOCOLATE."}
][
	{"Text":"YET ANOTHER SPHERICAL THING THAT IS TRYING TO HURT YOU..."},
	{"Text":"AT LEAST THIS TIME IT ISN'T STARING AT YOU."}
]␀␀␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"WE ARE PRETTY DEEP INTO THIS ALREADY."},
	{"Text":"I WONDER IF THERE IS ANY WAY OUT..."}
]␀␀␀␀␀␀␀␀␀␀[
	{"Text":"THE ALTITUDE AT THIS LOCATION IS RATHER NOTABLE."},
	{"Text":"I'D STRONGLY RECOMMEND AVOIDING AN UNINTENTIONAL DESCENT FROM THIS PLACE..."}
]␀␀␀␀␀␀␀[
	{"Text":"WATCH OUT FOR THAT ROCK ON THE GROUND."},
	{"Text":"YOU COULD SUSTAIN REAL BAD INJURIES FROM THAT!"}
]␀␀␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"LOOKS LIKE OUR SLIMY FRIEND TOOK A BREATHER."}
]␀␀␀␀[
	{"Text":"THIS LOOKS LIKE A HAUNTED PLACE..."},
	{"Text":"A SURREAL MIX OF THE LIVING AND THE DEAD."},
	{"Text":"TRULY CAPTIVATING."}
]␀␀␀␀␀␀␀[
	{"Text":"IS THIS CALLED THE MORGUE BECAUSE THERE ARE CORPSES EVERYWHERE,"},
	{"Text":"OR BECAUSE IT IS THE PLACE YOU BECOME ONE?"},
	{"Text":"EITHER WAY, IM JUST GONNA STAY HERE AT THIS SAVE SPOT."}
]␀␀␀␀␀[
	{"Text":"WOW, THEY ADDED THEM ON BOTH SIDES NOW."},
	{"Text":"SPLENDIFEROUS!"}
]␀␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"SEEN ANY GHOSTS DASHING AROUND YET?"},
	{"Text":"WHAT?"},
	{"Text":"SCARED?"},
	{"Text":"ME?"},
	{"Text":"uhm... no."}
]␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"ANOTHER FORM OF OBSTACLE WITH EYES."},
	{"Text":"GOOD THING THEY AREN'T ROUND THIS TIME."},
	{"Text":"WELL, I GUESS THEY SORT OF ARE..."}
]␀␀␀␀␀␀␀␀␀[
	{"Text":"ALL THIS PLATFORMING GOT ME DIZZY."},
	{"Text":"I NEED A BREAK..."}
]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"UP, DOWN, UP, DOWN,
 THAT'S HOW YOU DO IT!"},
	{"Text":"SAY IT WITH ME!"},
	{"Text":"UP!"},
	{"Text":"DOWN!"},
	{"Text":"UP!"},
	{"Text":"DOWN!"},
	{"Text":"VERY GOOD!
NOW AGAIN."},
	{"Text":"UP!"},
	{"Text":"DOWN!"},
	{"Text":"UP!"},
	{"Text":"DOWN!"},
	{"Text":"ARE YOU SAYING IT?"},
	{"Text":"OKAY LET'S TRY AGAIN!"},
	{"Text":"UP!"},
	{"Text":"DOWN!"},
	{"Text":"UP!"},
	{"Text":"DOWN!"},
	{"Text":"..."},
	{"Text":"I DON'T THINK YOU ARE TAKING THIS SERIOUS ENOUGH."},
	{"Text":"THAT WAS KIND OF A LET DOWN..."},
	{"Text":"I HOPE YOU ARE NEVER GONNA GIVE ME UP LIKE THAT AGAIN..."}
]␀␀␀␀␀␀␀␀␀[
	{"Text":"WAS IT REALLY A GOOD IDEA TO JUMP INTO HIS MOUTH?"},
	{"Text":"NOW WE DEFINITELY AREN'T GOING ANYWHERE..."}
]␀␀␀␀␀␀␀[
	{"Text":"DO THESE PIPES EVEN LEAD TO ANYWHERE?"},
	{"Text":"MAYBE THIS IS THE WAY OUT..."}
]␀[
	{"Text":"I THINK WE ARE ALMOST AT THE END!"},
	{"Text":"JUST A COUPLE MORE JUMPS..."}
]␀␀␀␀␀␀[
	{"Text":"JUMP CAREFULLY, THOSE MOVING SPIKE BLADES CAN BE NASTY."},
	{"Text":"TRUST ME."},
	{"Text":"I SPEAK FROM EXPERIENCE..."}
]␀␀␀␀␀␀␀␀␀␀[
	{"Text":"WHEN WILL THIS NIGHTMARE END?"},
	{"Text":"I CAN'T BEAR IT ANY LONGER..."}
]␀␀␀␀␀␀␀␀[
	{"Text":"STILL NOT OVER?"},
	{"Text":"KEEP GOING, I'LL CATCH UP WITH YOU IN A MOMENT."}
]␀␀␀␀[
	{"Text":"THIS ACID MAKES MY SKIN CRAWL..."}
][
	{"Text":"IS THAT SOME SORT OF ACID BLOB THING?"},
	{"Text":"IS IT ALIVE?"},
	{"Text":"hmmm..."},
	{"Text":"TRY JUMPING ON IT."},
	{"Text":"I PROMISE, NOTHING BAD WILL HAPPEN, TRUST ME."}
]␀[
	{"Text":"SEE?"},
	{"Text":"THOSE TURNED OUT TO BE VERY HELPFUL, JUST LIKE I TOLD YOU!"}
]␀␀␀␀[
	{"Text":"WOW WE HAVE REACHED THE END."},
	{"Text":"THAT WAS SURPRISINGLY FAST!"},
	{"Text":"BUT IS THIS REALLY THE EXIT?"}
]␀[
	{"Text":"HINT:
THE CORRECT TIMING IS KEY TO OVERCOME THIS OBSTACLE."}
]␀␀␀␀␀␀[
	{"Text":"GREAT MOVES!"},
	{"Text":"YOU'RE A PLATFORMING PRO!"}
]␀␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":" I CAN'T EVEN IMAGINE HOW IT WILL HURT WHEN YOU FALL INTO THAT ACID POOL..."}
]␀␀␀␀␀[
	{"Text":"HAVING A HARD TIME GETTING THROUGH THIS?"},
	{"Text":"WELL, DID YOU KNOW THAT YOU CAN ROLL RIGHT UNDER IT?"},
	{"Text":"IF YOU TIME IT CORRECTLY -"},
	{"Text":"FOR A MOMENT, YOU CAN JUMP OFF RIGHT AFTER LEAVING THE GROUND."}
]␀␀[
	{"Text":"SEEMS LIKE YOU'VE GOT THE HANG OF THE NEW TECHNIQUE."},
	{"Text":"YOU CAN DO IT HERE ASWELL, IT'S VERY USEFUL FOR SMALL GAPS."}
]␀␀␀[
	{"Text":"THESE PLATFORMS LOOK FAMILIAR..."}
][
	{"Text":"YOU'VE GOT THIS."},
	{"Text":"I THINK IT'S JUST A FEW MORE JUMPS."}
]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"THIS OBSTACLE IS UNLIKE ANYTHING WE'VE SEEN BEFORE."},
	{"Text":"I DON'T THINK I CAN MAKE IT."}
]␀␀␀[
	{"Text":"HINT:
GETTING HIT BY SPIKES KILLS YOU."}
]␀␀␀␀␀␀␀␀␀␀[
	{"Text":"STORAGE ROOM HUH..."},
	{"Text":"I WONDER WHAT THEY ACTUALLY STORE HERE..."}
]␀␀␀␀␀␀[
	{"Text":"HINT:
SPIKES ARE VERY BAD FOR YOUR HEALTH!"}
]␀␀␀␀␀␀[
	{"Text":"FOUND ANY WAY OUT YET?"},
	{"Text":"ME NEITHER..."},
	{"Text":"I'M JUST GONNA WAIT HERE FOR YOU."}
][
	{"Text":"I DON'T THINK WE ARE SUPPOSED TO BE UP HERE..."}
]␀␀[
	{"Text":"HINT:
FALLING IN PITS KILLS YOU..."},
	{"Text":"I SOMETIMES WONDER, AT WHAT POINT IN A PIT DO YOU ACTUALLY DIE?"}
]␀[
	{"Text":"WELL, WOULD YOU LOOK AT THAT."},
	{"Text":"ARE YOU LOOKING?"},
	{"Text":"..."}
]␀␀␀␀[
	{"Text":"SEE THAT WEIRD RED THING?"},
	{"Text":"TRY TO JUMP ON IT."}
]␀␀␀␀␀␀␀[
	{"Text":"SEEMS LIKE WE ARE ALMOST AT THE END."},
	{"Text":"AT LEAST YOU ARE..."},
	{"Text":"i am just watching"}
]␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"WHERE THE HELL AM I."},
	{"Text":"I MEAN..."},
	{"Text":"NEED ANY MORE HINTS?"},
	{"Text":"..."},
	{"Text":"yes?"},
	{"Text":"HINT:
COLLECTING 100 COINS WILL GIVE YOU ANOTHER LIFE."}
]␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"THE SPIKES JUST SEEM TO GET LONGER AND SHARPER EVERY TIME WE GET TO ANOTHER PLACE..."}
]␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"QUITE NICE UP HERE."},
	{"Text":"I'M FEELING VERY NOBLE RIGHT NOW."}
]␀␀␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"IT'S SO CHAOTIC AND CRAMPED IN HERE."},
	{"Text":"WHO DESIGNED THIS PLACE?"}
]␀␀␀␀␀␀[
	{"Text":"HINT:
DON'T FALL INTO THE LAVA."},
{"Text":"IT WILL END YOUR LIFE."}
]␀␀␀␀␀␀␀␀␀␀␀␀␀␀[
	{"Text":"BETTER NOT HIT YOUR HEAD ON THERE, THAT WOULD HURT LIKE HELL."},
	{"Text":"I'LL JUST STAY HERE AND LOOK OUT FOR YOU, IN CASE ANYTHING HAPPENS."}
]␀␀[
	{"Text":"WATCH OUT FOR THAT BIG BLOB THING WITH THE CROWN..."},
	{"Text":"I'M NOT SURE WHAT IT IS SUPPOSED TO BE, BUT IT DOES SEEM LIKE SOMETHING THAT IS DRINKING A LOT."}
][
	{"Text":"HOWDY!
I'M PIKIT.
PIKIT THE SIGN!"},
	{"Text":"HEE HEE HEE..."},
	{"Text":"..."},
	{"Text":"OH, IT'S YOU AGAIN."},
	{"Text":"DON'T ASK ME HOW I ENDED UP HERE."}
]␀␀[
	{"Text":"WOW..."},
	{"Text":"WHAT A FUN LOOKING PLACE!"},
	{"Text":"..."}
]␀␀[
	{"Text":"I THINK YOU MIGHT ALREADY KNOW THAT THOSE BOULDERS ARE DANGEROUS."},
	{"Text":"WELL, IF YOU DON'T..."},
	{"Text":"YOU'RE WELCOME!"}
