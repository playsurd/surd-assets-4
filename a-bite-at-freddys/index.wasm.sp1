attribute highp vec2 vertex; // attrib:0
/* clang-format on */

uniform vec2 offset;
uniform vec2 scale;

varying vec2 uv_interp;

void main() {
	uv_interp = vertex.xy * 2.0 - 1.0;

	vec2 v = vertex.xy * scale + offset;
	gl_Position = vec4(v, 0.0, 1.0);
}

